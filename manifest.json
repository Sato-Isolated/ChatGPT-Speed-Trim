{
   "manifest_version": 3,
   "name": "ChatGPT Speed Trim",
   "description": "Improves responsiveness in long ChatGPT conversations by trimming rendered history.",
   "version": "0.1.0",
   "permissions": ["storage", "activeTab"],
   "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
   "background": {
      "service_worker": "dist/background.js",
      "type": "module"
   },
   "action": {
      "default_popup": "src/popup.html"
   },
   "content_scripts": [
      {
         "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
         "js": ["dist/content.js"],
         "run_at": "document_start"
      },
      {
         "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
         "js": ["dist/page-main.js"],
         "run_at": "document_start",
         "world": "MAIN"
      }
   ],
   "web_accessible_resources": [
      {
         "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
         "resources": ["dist/page-main.js"]
      }
   ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   }
}
